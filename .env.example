# Valores fictícios para demonstração local. Personalize a senha do banco,
# a chave JWT e a senha do administrador na sua instalação.

# PostgreSQL
POSTGRES_USER=fraud
POSTGRES_PASSWORD=demo-postgres-1234
POSTGRES_DB=fraud_detection
POSTGRES_PORT=5432

# Docker Compose hosts
BACKEND_PORT=8000
FRONTEND_PORT=4200

# Host para execução local. O Compose usa "db" na rede interna.
DATABASE_HOST=127.0.0.1

# Chave de demonstração (mínimo de 32 caracteres).
JWT_SECRET_KEY=demo-local-jwt-secret-change-this-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false
# Conta inicial para demonstração em banco vazio.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=demo-admin-1234

# Armazenamento e uploads
DATASET_STORAGE_PATH=storage/datasets
MAX_DATASET_UPLOAD_BYTES=209715200
DATASET_UPLOAD_MULTIPART_OVERHEAD_BYTES=4194304
ANALYSIS_MATRIX_MEMORY_LIMIT_BYTES=536870912
DATASET_UPLOAD_CHUNK_BYTES=1048576
INGESTION_COPY_BUFFER_BYTES=1048576
INGESTION_PROGRESS_EVERY_ROWS=50000

# CORS; formato JSON esperado pelo Pydantic
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:4200","http://127.0.0.1:4200"]
