# PostgreSQL
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=fraud_detection
POSTGRES_PORT=5432

# Docker Compose hosts
BACKEND_PORT=8000
FRONTEND_PORT=4200

# URL local usada ao executar o backend diretamente no host.
# O Docker Compose substitui o host por "db" e monta a URL automaticamente.
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/fraud_detection

# Autenticacao
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Armazenamento e uploads
DATASET_STORAGE_PATH=storage/datasets
MAX_DATASET_UPLOAD_BYTES=209715200
DATASET_UPLOAD_CHUNK_BYTES=1048576
INGESTION_COPY_BUFFER_BYTES=1048576
INGESTION_PROGRESS_EVERY_ROWS=50000

# OpenCL/Pocl
# Ajuste estes valores para a quantidade real de CPUs reservadas ao backend.
BACKEND_CPUS=6
POCL_MAX_PU_COUNT=6
POCL_CPU_MAX_THREADS=6
OMP_NUM_THREADS=6
OPENBLAS_NUM_THREADS=1

# CORS; formato JSON esperado pelo Pydantic
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:4200","http://127.0.0.1:4200"]
